# Настройки локального диспетчера agent-bridge.
#
# Куда класть: ~/.config/oborot-agent-bridge/config.env
# (install.sh копирует этот файл туда сам, если его ещё нет).
#
# Формат — KEY=VALUE, строка на настройку, без экспорта и без подстановок.
# Файл читается процессом, а не оболочкой: `$HOME` и `~` здесь не раскрываются
# нигде, кроме путей — их диспетчер разворачивает сам.
#
# Приоритет: переменная окружения важнее файла, файл важнее значения по
# умолчанию. Все ключи необязательные.
#
# СЕКРЕТОВ В ЭТОМ ФАЙЛЕ БЫТЬ НЕ ДОЛЖНО. Диспетчер не принимает ни API-ключей,
# ни токенов: доступ к GitHub берётся из уже авторизованного `gh`, доступ к
# модели — из уже авторизованного `claude` под подпиской Claude Max.

# Репозиторий вида owner/name. Пусто — определяется по `gh repo view`
# и по `origin` того каталога, где лежит bridge.py.
# OBOROT_BRIDGE_REPO=chernim-cherno-analytics/oborot-saas

# Какие ветки обслуживать. Код в проекте пишет один исполнитель, его ветки — claude/*.
# OBOROT_BRIDGE_BRANCH_PREFIX=claude/

# Логины ревьюеров, чьи замечания считаются заданием. Через запятую.
# Значение по умолчанию — бот нативного Codex Cloud Code Review. Если в PR он
# подписывается иначе, посмотрите фактический логин:
#   gh api repos/<owner>/<name>/pulls/<N>/reviews --jq '.[].user.login'
# и впишите сюда. Пока логин не совпадает, диспетчер молчит: чинить по
# замечаниям неизвестно кого он не будет.
# OBOROT_BRIDGE_REVIEWER_LOGINS=chatgpt-codex-connector[bot]

# Потолок попыток на один и тот же SHA. Больше трёх ставить не стоит: если три
# захода не закрыли замечание, дело не в количестве заходов.
# OBOROT_BRIDGE_MAX_ATTEMPTS=3

# Рабочая копия диспетчера. По умолчанию — <каталог состояния>/checkout,
# отдельный клон. Указывать сюда каталог, в котором работает человек, нельзя:
# диспетчер делает в своей копии `checkout --force` и `clean -fd`.
# OBOROT_BRIDGE_CHECKOUT=

# Каталог состояния: журнал, state.json, блокировка, рабочая копия.
# По умолчанию ~/.local/state/oborot-agent-bridge
# OBOROT_BRIDGE_STATE_DIR=

# Чем проверять правку перед публикацией. Пустая строка отключает тесты —
# не делайте так: непроверенное изменение уезжает в ветку, из которой прод
# обновляется автоматически.
#
# По умолчанию — ровно та команда, которой проверяет CI (.github/workflows/ci.yml).
# `--jobs 3` обязателен: без него раннер поднимает все наборы разом, они мешают
# друг другу и дают падения, которых в CI нет. Меняя её здесь, вы соглашаетесь,
# что «зелено у диспетчера» и «зелено в CI» — больше не одно и то же.
# OBOROT_BRIDGE_TEST_CMD=python3 tests/run_all.py --jobs 3
# OBOROT_BRIDGE_TEST_TIMEOUT=2700

# Интерпретатор для тестов. У системного python3 нет зависимостей проекта, и
# набор упадёт на первом импорте — а выглядеть это будет как «правка сломала
# тесты». Соберите venv из того же lock-файла, что ставит CI и деплой:
#
#   python3 -m venv ~/.local/state/oborot-agent-bridge/venv
#   ~/.local/state/oborot-agent-bridge/venv/bin/pip install -r requirements.lock
#
# и укажите путь сюда. Обновлять venv нужно при каждом изменении requirements.lock.
# OBOROT_BRIDGE_TEST_PYTHON=

# Пути к исполняемым файлам, если автоопределение промахнулось.
# Проверить, что нашлось: tools/agent-bridge/run.sh health
# OBOROT_BRIDGE_CLAUDE_BIN=
# OBOROT_BRIDGE_GH_BIN=
# OBOROT_BRIDGE_GIT_BIN=
# OBOROT_BRIDGE_PYTHON_BIN=

# Модель и дополнительные аргументы локального Claude Code. Пусто — то, что
# выбрано в самом Claude Code. Ключи API сюда не пишутся никогда.
# OBOROT_BRIDGE_CLAUDE_MODEL=
# OBOROT_BRIDGE_CLAUDE_EXTRA_ARGS=
# OBOROT_BRIDGE_CLAUDE_TIMEOUT=1800

# Сколько inline-замечаний отдавать за один прогон. Остальные приедут следующим
# циклом: запрос на двести замечаний исполняется хуже, чем три по семьдесят.
# Отложенные замечания диспетчер обработанными не считает — они действительно
# приедут, а не потеряются. Учтите потолок попыток: за MAX_ATTEMPTS прогонов на
# один SHA успевает уехать не больше MAX_ATTEMPTS × MAX_INLINE_COMMENTS штук.
# OBOROT_BRIDGE_MAX_INLINE_COMMENTS=60

# Канонический issue-канал координации агентов: номер issue, в который
# дублируются ключевые исходы (PUSHED, TESTS_FAILED, PUSH_REJECTED,
# CLAUDE_FAILED, NO_CHANGES, NEEDS_HUMAN). Комментарий в PR видит тот, кто
# смотрит в PR; общий канал — единственное место, где видно состояние всей
# связки. Защита от дублей — маркер в самом issue, так что повторный прогон
# ничего не задваивает. 0 отключает зеркалирование.
# OBOROT_BRIDGE_COORDINATION_ISSUE=2

# Ревью без замечаний распознаётся по этому шаблону и не будит Claude.
# OBOROT_BRIDGE_NOOP_REVIEW_PATTERN=

# Размер журнала, после которого он усекается, байт.
# OBOROT_BRIDGE_LOG_KEEP_BYTES=5242880
