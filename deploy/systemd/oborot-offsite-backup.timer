[Unit]
Description=Оборот: копия вне сервера каждую ночь

[Timer]
OnCalendar=*-*-* 03:20:00
# Сдвиг, чтобы копия не начиналась в ту же секунду, что и всё остальное.
RandomizedDelaySec=900
# Пропущенный запуск (сервер был выключен) выполняется при ближайшей
# возможности: иначе неделя простоя означает неделю без копий, и узнаем мы об
# этом в день аварии.
Persistent=true

[Install]
WantedBy=timers.target
