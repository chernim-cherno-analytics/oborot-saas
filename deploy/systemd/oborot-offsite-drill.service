[Unit]
Description=Оборот: учение по восстановлению из удалённого хранилища
After=network-online.target
Wants=network-online.target
# Копия OBOROT_SECRET приезжает из ОТДЕЛЬНО ПОДКЛЮЧЁННОГО хранилища, а не лежит
# файлом на диске сервера: файл рядом с базой умирает вместе с ней, и учение с
# ним доказывало бы только то, что сервер знает собственный ключ.
#
# RequiresMountsFor выстраивает порядок: учение стартует после монтирования.
# AssertPathIsMountPoint — само требование: если каталог НЕ является точкой
# монтирования (не поднялся sshfs, отвалился NFS, кто-то положил туда обычный
# файл), учение падает с ошибкой. Именно падает, а не пропускается: Condition*
# дал бы «успешно пропущено», то есть тихое отсутствие учения — тот самый
# зелёный отчёт ни о чём.
#
# Путь должен совпадать с каталогом OBOROT_RECOVERY_SECRET_FILE из
# /opt/oborot/backup.env. Меняете там — меняйте здесь.
RequiresMountsFor=/mnt/oborot-recovery
AssertPathIsMountPoint=/mnt/oborot-recovery

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/oborot/app-src
ExecStart=/bin/bash /opt/oborot/app-src/deploy/offsite_restore_drill.sh
# Учение поднимает приложение на восстановленной базе на отдельном порту.
Environment=RESTORE_PORT=8099
# OBOROT_SECRET здесь нет и быть не может: учение обязано проверять ОТДЕЛЬНУЮ
# офсайт-копию секрета (OBOROT_RECOVERY_SECRET_FILE в /opt/oborot/backup.env),
# а не тот ключ, который и так лежит на этой машине. С секретом в окружении
# скрипт откажется работать намеренно.
# По той же причине здесь нет и OBOROT_DRILL_ALLOW_LOCAL_SECRET: послабление
# для стенда, где нечего монтировать, в учении по расписанию смысла не имеет.
Nice=15
IOSchedulingClass=idle
# Полная проверка данных читает всё хранилище: на медленном канале это долго.
TimeoutStartSec=3h
