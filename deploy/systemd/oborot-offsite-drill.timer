[Unit]
Description=Оборот: еженедельное учение по восстановлению

[Timer]
# Раз в неделю. Копия, которую ни разу не восстанавливали, бэкапом не является
# — а «восстанавливали полгода назад» немногим лучше.
OnCalendar=Sun *-*-* 04:40:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
