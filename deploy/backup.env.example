# Copy to /opt/oborot/backup.env, fill values and chmod 600.
# Repository MUST live outside the production VPS.
RESTIC_REPOSITORY=sftp:oborot-backup:/srv/restic/oborot
RESTIC_PASSWORD_FILE=/opt/oborot/restic-password
RESTIC_HOST=oborot-production

OBOROT_DATA_DIR=/opt/oborot/data
OBOROT_DB_PATH=/opt/oborot/data/oborot.db
OBOROT_BACKUP_STATE_DIR=/opt/oborot/backup-state

# S3-compatible backends can use the same scripts; replace RESTIC_REPOSITORY
# and place provider credentials here (file permissions must remain 600):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
