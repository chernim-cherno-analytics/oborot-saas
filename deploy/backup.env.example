# Настройка офсайт-бэкапа. Скопировать на сервер как /opt/oborot/backup.env,
# заполнить и обязательно закрыть от чужих глаз:
#
#   install -m 600 /dev/null /opt/oborot/backup.env
#   $EDITOR /opt/oborot/backup.env
#
# ЭТОТ ФАЙЛ — ОБРАЗЕЦ. Настоящие значения в репозиторий не попадают никогда:
# ни адрес хранилища, ни пароль, ни ключи доступа.

# Куда складывать копии. ОБЯЗАТЕЛЬНО вне этой машины: скрипт откажется
# работать с локальным путём. Поддерживаются sftp: s3: b2: rest: azure: gs:
# swift: rclone:
#
# Самый дешёвый вариант, если есть любая вторая машина с ssh:
RESTIC_REPOSITORY=sftp:пользователь@вторая-машина:/srv/restic/oborot
#
# S3-совместимое хранилище — тогда сюда же кладутся ключи доступа:
# RESTIC_REPOSITORY=s3:storage.yandexcloud.net/имя-корзины
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Пароль шифрования — ТОЛЬКО файлом, не строкой в окружении. Потеря этого
# пароля означает потерю всех копий: restic шифрует на стороне сервера, и
# расшифровать их больше нечем. Держите второй экземпляр пароля отдельно от
# сервера.
#
#   install -m 600 /dev/null /opt/oborot/restic-password
#   head -c 32 /dev/urandom | base64 > /opt/oborot/restic-password
RESTIC_PASSWORD_FILE=/opt/oborot/restic-password

# ВТОРОЙ КЛЮЧ, без которого восстановление неполное.
#
# Пароль restic открывает копию базы. Но токены МойСклада внутри базы зашифрованы
# ещё раз — ключом, выведенным из OBOROT_SECRET приложения (app/crypto.py).
# Восстановление без него даёт систему, которая поднимается и показывает старые
# цифры, но не может ни синхронизироваться, ни записать заказ.
#
# Здесь указывается путь к ОТДЕЛЬНОЙ копии этого секрета — той самой, которую
# берут в день аварии. Учение по восстановлению читает её и проверяет, что
# сохранённые токены ею действительно расшифровываются; без этой строки учение
# не запускается вовсе.
#
#   install -m 600 /dev/null /opt/oborot/recovery-secret
#   $EDITOR /opt/oborot/recovery-secret     # ровно то же значение, что OBOROT_SECRET
#
# Правило про хранение то же, что у пароля restic, и по той же причине: второй
# экземпляр обоих секретов держат ВНЕ этого сервера и не в том же хранилище,
# куда уезжают копии. Ключ рядом с копией отменяет смысл шифрования копии.
#
# И отдельно: сам OBOROT_SECRET в этот файл вписывать НЕЛЬЗЯ. Учение с секретом
# в окружении откажется работать — иначе оно проверяло бы, что сервер знает свой
# собственный ключ, а не что офсайт-копия ключа подходит к офсайт-копии базы.
OBOROT_RECOVERY_SECRET_FILE=/opt/oborot/recovery-secret

# Метка машины в снимках. Меняйте, если серверов станет больше одного.
RESTIC_HOST=oborot-production

OBOROT_DB=/opt/oborot/data/oborot.db
OBOROT_BACKUP_STATE_DIR=/opt/oborot/backup-state

# Сколько снимков хранить.
# OBOROT_KEEP_DAILY=14
# OBOROT_KEEP_WEEKLY=8
# OBOROT_KEEP_MONTHLY=12
