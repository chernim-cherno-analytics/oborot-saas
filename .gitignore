# Сопутствующие файлы WAL: с 22.08 SQLite открывается в режиме WAL, и рядом с
# базой появляются <база>.db-wal и <база>.db-shm (см. app/db.py).
oborot.db-wal
oborot.db-shm
test_*.db-wal
test_*.db-shm
# Базы разовых прогонов для снимков экрана (SUPPLY-FIX-4): такой файл уже
# попал в коммит один раз, и стоил он шести мегабайт в истории. Правило
# заведено вместо обещания быть внимательнее.
shot*.db
shot*.db-wal
shot*.db-shm
ci_*.db
ci_*.db-wal
ci_*.db-shm

# Рабочие каталоги наборов, гоняющих настоящие скрипты (бэкап, деплой, офсайт).
# Каждый набор убирает за собой сам, но при аварийном выходе каталог остаётся —
# и однажды уже попал в индекс вместе с подставными репозиториями внутри.
test_backup_work_*/
